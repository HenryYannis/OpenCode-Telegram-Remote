{
  "name": "opencode-telegram-remote",
  "version": "0.1.1",
  "description": "A Telegram remote control for OpenCode (V2 plugin): chat with any window from your phone, switch models & sessions, and get desktop replies pushed back in real time.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/util.js",
    "test": "node --test test/*.test.js",
    "validate": "node scripts/validate-package.mjs",
    "smoke": "node scripts/smoke.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "ci": "npm run check && npm test && npm run validate && npm run smoke && npm run pack:dry-run"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "telegram",
    "telegram-bot",
    "remote",
    "ai-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryYannis/opencode-telegram-remote.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.0",
    "grammy": "^1.35.0"
  }
}
